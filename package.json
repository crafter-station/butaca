{
  "name": "butaca",
  "version": "0.1.0",
  "description": "CLI de carteleras y funciones de Cinemark Argentina",
  "type": "module",
  "bin": {
    "butaca": "./dist/cli.js"
  },
  "files": ["dist", "skills", "README.md", "CONTRACT.md"],
